<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="15dp"
    android:paddingVertical="13dp">

    <ImageView
        android:id="@+id/rowIcon"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@drawable/bg_ic_tile"
        android:contentDescription="@null"
        android:padding="9dp"
        android:src="@drawable/ic_row_generic"
        android:tint="@color/lg_blued_ink" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="13dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/rowTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/lg_ink_100"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/rowDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/lg_ink_400"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/rowValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_chip"
        android:paddingHorizontal="8dp"
        android:paddingVertical="3dp"
        android:textColor="@color/lg_ink_300"
        android:textSize="10.5sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/rowChevron"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:text="›"
        android:textColor="@color/lg_ink_400"
        android:textSize="18sp" />
</LinearLayout>
