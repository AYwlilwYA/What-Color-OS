<?xml version="1.0" encoding="utf-8"?>
<!-- [doc/spec/64] 桌面动画参数三级页（打开/关闭/打断三组共用，键名由代码按组拼装） -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <com.coloros16.liquidglass.ui.LgSwitch
            android:id="@+id/switchAnimEnabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_anim_enable_custom"
                    android:thumb="@drawable/lg_sw_thumb"
                    android:track="@drawable/lg_sw_track"
                        android:textSize="15sp"
                        android:textColor="@color/lg_ink_100"
                        android:minHeight="0dp"
                    />

        <TextView
            android:id="@+id/animEnabledDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/settings_anim_enable_custom_desc"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?android:attr/textColorSecondary" />

        <!-- [spec/64] 一键预设：iOS 风格弹簧档位，一键套用本组全部 9 个参数 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/settings_anim_preset_title"
            android:textAppearance="?attr/textAppearanceTitleSmall" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/settings_anim_preset_desc"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?android:attr/textColorSecondary" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/animPresetChips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:chipSpacingHorizontal="8dp" />

        <!-- [spec/64] 仅「打断动画」页可见：把「打开动画」参数整组复制过来 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSyncFromOpen"
            style="@style/ShellBtnOutlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/settings_anim_sync_open"
            android:visibility="gone" />

        <TextView
            android:id="@+id/txtSyncFromOpenDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/settings_anim_sync_open_desc"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?android:attr/textColorSecondary"
            android:visibility="gone" />

        <!-- 中心 X 轴 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/settings_anim_sec_x"
            android:textAppearance="?attr/textAppearanceTitleSmall" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:layout_marginTop="6dp">
    <TextView android:fontFamily="sans-serif-medium" android:textColor="@color/lg_ink_100" android:textSize="14sp"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/settings_anim_damping" />
    <TextView
            android:id="@+id/animXDampingValue" android:fontFamily="monospace" android:letterSpacing="0.04" android:textColor="@color/lg_blued_ink" android:textSize="13sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
</LinearLayout>

        <SeekBar
            android:id="@+id/seekAnimXDamping"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="290"
            android:progress="130"
                    android:progressDrawable="@drawable/lg_seek_track"
                    android:splitTrack="false"
                    android:thumb="@drawable/lg_seek_thumb"
                    />

        

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:layout_marginTop="6dp">
    <TextView android:fontFamily="sans-serif-medium" android:textColor="@color/lg_ink_100" android:textSize="14sp"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/settings_anim_stiffness" />
    <TextView
            android:id="@+id/animXStiffnessValue" android:fontFamily="monospace" android:letterSpacing="0.04" android:textColor="@color/lg_blued_ink" android:textSize="13sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
</LinearLayout>

        <SeekBar
            android:id="@+id/seekAnimXStiffness"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="2999"
            android:progress="579"
                    android:progressDrawable="@drawable/lg_seek_track"
                    android:splitTrack="false"
                    android:thumb="@drawable/lg_seek_thumb"
                    />

        

        <!-- 中心 Y 轴 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/settings_anim_sec_y"
            android:textAppearance="?attr/textAppearanceTitleSmall" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:layout_marginTop="6dp">
    <TextView android:fontFamily="sans-serif-medium" android:textColor="@color/lg_ink_100" android:textSize="14sp"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/settings_anim_damping" />
    <TextView
            android:id="@+id/animYDampingValue" android:fontFamily="monospace" android:letterSpacing="0.04" android:textColor="@color/lg_blued_ink" android:textSize="13sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
</LinearLayout>

        <SeekBar
            android:id="@+id/seekAnimYDamping"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="290"
            android:progress="130"
                    android:progressDrawable="@drawable/lg_seek_track"
                    android:splitTrack="false"
                    android:thumb="@drawable/lg_seek_thumb"
                    />

        

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:layout_marginTop="6dp">
    <TextView android:fontFamily="sans-serif-medium" android:textColor="@color/lg_ink_100" android:textSize="14sp"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/settings_anim_stiffness" />
    <TextView
            android:id="@+id/animYStiffnessValue" android:fontFamily="monospace" android:letterSpacing="0.04" android:textColor="@color/lg_blued_ink" android:textSize="13sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
</LinearLayout>

        <SeekBar
            android:id="@+id/seekAnimYStiffness"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="2999"
            android:progress="579"
                    android:progressDrawable="@drawable/lg_seek_track"
                    android:splitTrack="false"
                    android:thumb="@drawable/lg_seek_thumb"
                    />

        

        <!-- 宽度缩放 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/settings_anim_sec_width"
            android:textAppearance="?attr/textAppearanceTitleSmall" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:layout_marginTop="6dp">
    <TextView android:fontFamily="sans-serif-medium" android:textColor="@color/lg_ink_100" android:textSize="14sp"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/settings_anim_damping" />
    <TextView
            android:id="@+id/animWidthDampingValue" android:fontFamily="monospace" android:letterSpacing="0.04" android:textColor="@color/lg_blued_ink" android:textSize="13sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
</LinearLayout>

        <SeekBar
            android:id="@+id/seekAnimWidthDamping"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="290"
            android:progress="130"
                    android:progressDrawable="@drawable/lg_seek_track"
                    android:splitTrack="false"
                    android:thumb="@drawable/lg_seek_thumb"
                    />

        

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:layout_marginTop="6dp">
    <TextView android:fontFamily="sans-serif-medium" android:textColor="@color/lg_ink_100" android:textSize="14sp"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/settings_anim_stiffness" />
    <TextView
            android:id="@+id/animWidthStiffnessValue" android:fontFamily="monospace" android:letterSpacing="0.04" android:textColor="@color/lg_blued_ink" android:textSize="13sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
</LinearLayout>

        <SeekBar
            android:id="@+id/seekAnimWidthStiffness"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="2999"
            android:progress="579"
                    android:progressDrawable="@drawable/lg_seek_track"
                    android:splitTrack="false"
                    android:thumb="@drawable/lg_seek_thumb"
                    />

        

        <!-- 宽高比例 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/settings_anim_sec_height"
            android:textAppearance="?attr/textAppearanceTitleSmall" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:layout_marginTop="6dp">
    <TextView android:fontFamily="sans-serif-medium" android:textColor="@color/lg_ink_100" android:textSize="14sp"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/settings_anim_damping" />
    <TextView
            android:id="@+id/animHeightDampingValue" android:fontFamily="monospace" android:letterSpacing="0.04" android:textColor="@color/lg_blued_ink" android:textSize="13sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
</LinearLayout>

        <SeekBar
            android:id="@+id/seekAnimHeightDamping"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="290"
            android:progress="130"
                    android:progressDrawable="@drawable/lg_seek_track"
                    android:splitTrack="false"
                    android:thumb="@drawable/lg_seek_thumb"
                    />

        

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:layout_marginTop="6dp">
    <TextView android:fontFamily="sans-serif-medium" android:textColor="@color/lg_ink_100" android:textSize="14sp"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/settings_anim_stiffness" />
    <TextView
            android:id="@+id/animHeightStiffnessValue" android:fontFamily="monospace" android:letterSpacing="0.04" android:textColor="@color/lg_blued_ink" android:textSize="13sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
</LinearLayout>

        <SeekBar
            android:id="@+id/seekAnimHeightStiffness"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="2999"
            android:progress="579"
                    android:progressDrawable="@drawable/lg_seek_track"
                    android:splitTrack="false"
                    android:thumb="@drawable/lg_seek_thumb"
                    />

        

        <!-- 图标透明度 -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:layout_marginTop="16dp">
    <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/settings_anim_sec_fade"
            android:textAppearance="?attr/textAppearanceTitleSmall" />
    <TextView
            android:id="@+id/animFadeDurationValue" android:fontFamily="monospace" android:letterSpacing="0.04" android:textColor="@color/lg_blued_ink" android:textSize="13sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
</LinearLayout>

        <SeekBar
            android:id="@+id/seekAnimFadeDuration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:max="145"
            android:progress="29"
                    android:progressDrawable="@drawable/lg_seek_track"
                    android:splitTrack="false"
                    android:thumb="@drawable/lg_seek_thumb"
                    />

        

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/settings_anim_restart_note"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?android:attr/textColorSecondary" />

    </LinearLayout>
</ScrollView>
