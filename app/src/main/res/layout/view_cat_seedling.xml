<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <com.coloros16.liquidglass.ui.LgSwitch
            android:id="@+id/switchSeedlingTakeover"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_seedling_takeover"
                    android:thumb="@drawable/lg_sw_thumb"
                    android:track="@drawable/lg_sw_track"
                        android:textSize="15sp"
                        android:textColor="@color/lg_ink_100"
                        android:minHeight="0dp"
                    />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/settings_seedling_takeover_desc"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?android:attr/textColorSecondary" />

        <com.coloros16.liquidglass.ui.LgSwitch
            android:id="@+id/switchSeedlingTakeoverGlass"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/settings_seedling_takeover_glass"
                    android:thumb="@drawable/lg_sw_thumb"
                    android:track="@drawable/lg_sw_track"
                        android:textSize="15sp"
                        android:textColor="@color/lg_ink_100"
                        android:minHeight="0dp"
                    />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/settings_seedling_takeover_glass_desc"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?android:attr/textColorSecondary" />

        <com.coloros16.liquidglass.ui.LgSwitch
            android:id="@+id/switchSeedlingCardGlass"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/settings_seedling_card_glass"
                    android:thumb="@drawable/lg_sw_thumb"
                    android:track="@drawable/lg_sw_track"
                        android:textSize="15sp"
                        android:textColor="@color/lg_ink_100"
                        android:minHeight="0dp"
                    />

        <TextView
            android:id="@+id/seedlingCardGlassDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/settings_seedling_card_glass_desc"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?android:attr/textColorSecondary" />

        <com.coloros16.liquidglass.ui.LgSwitch
            android:id="@+id/switchSeedlingCapsuleGlass"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/settings_seedling_capsule_glass"
                    android:thumb="@drawable/lg_sw_thumb"
                    android:track="@drawable/lg_sw_track"
                        android:textSize="15sp"
                        android:textColor="@color/lg_ink_100"
                        android:minHeight="0dp"
                    />

        <TextView
            android:id="@+id/seedlingCapsuleGlassDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/settings_seedling_capsule_glass_desc"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?android:attr/textColorSecondary" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:layout_marginTop="16dp">
    <TextView
            android:id="@+id/seedlingExpandRatioLabel"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/settings_seedling_expand_ratio"
            android:textAppearance="?attr/textAppearanceTitleSmall" />
    <TextView
            android:id="@+id/seedlingExpandRatioValue" android:fontFamily="monospace" android:letterSpacing="0.04" android:textColor="@color/lg_blued_ink" android:textSize="13sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
</LinearLayout>

        <SeekBar
            android:id="@+id/seekSeedlingExpandRatio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:max="250"
            android:progress="70"
                    android:progressDrawable="@drawable/lg_seek_track"
                    android:splitTrack="false"
                    android:thumb="@drawable/lg_seek_thumb"
                    />

        

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/settings_seedling_expand_ratio_desc"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?android:attr/textColorSecondary" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:layout_marginTop="16dp">
    <TextView
            android:id="@+id/seedlingCornerRatioLabel"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/settings_seedling_corner_ratio"
            android:textAppearance="?attr/textAppearanceTitleSmall" />
    <TextView
            android:id="@+id/seedlingCornerRatioValue" android:fontFamily="monospace" android:letterSpacing="0.04" android:textColor="@color/lg_blued_ink" android:textSize="13sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
</LinearLayout>

        <SeekBar
            android:id="@+id/seekSeedlingCornerRatio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:max="450"
            android:progress="170"
                    android:progressDrawable="@drawable/lg_seek_track"
                    android:splitTrack="false"
                    android:thumb="@drawable/lg_seek_thumb"
                    />

        

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/settings_seedling_corner_ratio_desc"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?android:attr/textColorSecondary" />

        <com.coloros16.liquidglass.ui.LgSwitch
            android:id="@+id/switchSeedlingForceTransparentBg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/settings_seedling_force_transparent_bg"
                    android:thumb="@drawable/lg_sw_thumb"
                    android:track="@drawable/lg_sw_track"
                        android:textSize="15sp"
                        android:textColor="@color/lg_ink_100"
                        android:minHeight="0dp"
                    />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/settings_seedling_force_transparent_bg_desc"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?android:attr/textColorSecondary" />

    </LinearLayout>
</ScrollView>
