<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ===== 总控 ===== -->
        <LinearLayout style="@style/ShellGroupHead">
            <TextView style="@style/ShellGroupTitle" android:text="@string/sb_group_control" />
            <TextView android:id="@+id/infoSbControl" style="@style/ShellGroupInfo" />
            <View style="@style/ShellGroupRule" />
        </LinearLayout>
        <com.google.android.material.card.MaterialCardView style="@style/ShellPlate" android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="14dp">
            <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:divider="@drawable/bg_seam_line_inset" android:dividerHeight="1dp" android:showDividers="middle">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="15dp" android:paddingVertical="13dp">
                    <com.coloros16.liquidglass.ui.LgSwitch android:id="@+id/switchSbEnable" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/sb_enable" android:thumb="@drawable/lg_sw_thumb" android:track="@drawable/lg_sw_track" android:textSize="15sp" android:textColor="@color/lg_ink_100" android:minHeight="0dp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/sb_enable_desc" android:textAppearance="?attr/textAppearanceBodySmall" android:textColor="?android:attr/textColorSecondary" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="15dp" android:paddingVertical="13dp">
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnSbSimplify" style="@style/ShellBtnText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="0dp" android:text="@string/sb_simplify" android:textSize="15sp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/sb_simplify_desc" android:textAppearance="?attr/textAppearanceBodySmall" android:textColor="?android:attr/textColorSecondary" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===== 图标显隐 ===== -->
        <LinearLayout style="@style/ShellGroupHead">
            <TextView style="@style/ShellGroupTitle" android:text="@string/sb_group_icons" />
            <TextView android:id="@+id/infoSbIcons" style="@style/ShellGroupInfo" />
            <View style="@style/ShellGroupRule" />
        </LinearLayout>
        <com.google.android.material.card.MaterialCardView style="@style/ShellPlate" android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="14dp">
            <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:divider="@drawable/bg_seam_line_inset" android:dividerHeight="1dp" android:showDividers="middle">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="15dp" android:paddingVertical="11dp">
                    <com.coloros16.liquidglass.ui.LgSwitch android:id="@+id/switchSbHideNotifIcons" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/sb_hide_notif_icons" android:thumb="@drawable/lg_sw_thumb" android:track="@drawable/lg_sw_track" android:textSize="15sp" android:textColor="@color/lg_ink_100" android:minHeight="0dp" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="15dp" android:paddingVertical="11dp">
                    <com.coloros16.liquidglass.ui.LgSwitch android:id="@+id/switchSbHideNetworkType" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/sb_hide_network_type" android:thumb="@drawable/lg_sw_thumb" android:track="@drawable/lg_sw_track" android:textSize="15sp" android:textColor="@color/lg_ink_100" android:minHeight="0dp" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="15dp" android:paddingVertical="11dp">
                    <com.coloros16.liquidglass.ui.LgSwitch android:id="@+id/switchSbTypeRightOfSignal" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/sb_type_right_of_signal" android:thumb="@drawable/lg_sw_thumb" android:track="@drawable/lg_sw_track" android:textSize="15sp" android:textColor="@color/lg_ink_100" android:minHeight="0dp" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="15dp" android:paddingVertical="11dp">
                    <com.coloros16.liquidglass.ui.LgSwitch android:id="@+id/switchSbHideRoaming" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/sb_hide_roaming" android:thumb="@drawable/lg_sw_thumb" android:track="@drawable/lg_sw_track" android:textSize="15sp" android:textColor="@color/lg_ink_100" android:minHeight="0dp" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="15dp" android:paddingVertical="11dp">
                    <com.coloros16.liquidglass.ui.LgSwitch android:id="@+id/switchSbHideDataActivity" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/sb_hide_data_activity" android:thumb="@drawable/lg_sw_thumb" android:track="@drawable/lg_sw_track" android:textSize="15sp" android:textColor="@color/lg_ink_100" android:minHeight="0dp" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="15dp" android:paddingVertical="11dp">
                    <com.coloros16.liquidglass.ui.LgSwitch android:id="@+id/switchSbHideWifiActivity" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/sb_hide_wifi_activity" android:thumb="@drawable/lg_sw_thumb" android:track="@drawable/lg_sw_track" android:textSize="15sp" android:textColor="@color/lg_ink_100" android:minHeight="0dp" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="15dp" android:paddingVertical="11dp">
                    <com.coloros16.liquidglass.ui.LgSwitch android:id="@+id/switchSbHideWifiTech" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/sb_hide_wifi_tech" android:thumb="@drawable/lg_sw_thumb" android:track="@drawable/lg_sw_track" android:textSize="15sp" android:textColor="@color/lg_ink_100" android:minHeight="0dp" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="15dp" android:paddingVertical="11dp">
                    <com.coloros16.liquidglass.ui.LgSwitch android:id="@+id/switchSbHideMobileDataOff" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/sb_hide_mobile_data_off" android:thumb="@drawable/lg_sw_thumb" android:track="@drawable/lg_sw_track" android:textSize="15sp" android:textColor="@color/lg_ink_100" android:minHeight="0dp" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="15dp" android:paddingVertical="11dp">
                    <com.coloros16.liquidglass.ui.LgSwitch android:id="@+id/switchSbHideMobileWifi" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/sb_hide_mobile_wifi" android:thumb="@drawable/lg_sw_thumb" android:track="@drawable/lg_sw_track" android:textSize="15sp" android:textColor="@color/lg_ink_100" android:minHeight="0dp" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="15dp" android:paddingVertical="11dp">
                    <com.coloros16.liquidglass.ui.LgSwitch android:id="@+id/switchSbKeepSim25g" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/sb_keep_sim2_5g" android:thumb="@drawable/lg_sw_thumb" android:track="@drawable/lg_sw_track" android:textSize="15sp" android:textColor="@color/lg_ink_100" android:minHeight="0dp" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="15dp" android:paddingVertical="11dp">
                    <com.coloros16.liquidglass.ui.LgSwitch android:id="@+id/switchSbDuo" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/sb_duo" android:thumb="@drawable/lg_sw_thumb" android:track="@drawable/lg_sw_track" android:textSize="15sp" android:textColor="@color/lg_ink_100" android:minHeight="0dp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/sb_duo_desc" android:textAppearance="?attr/textAppearanceBodySmall" android:textColor="?android:attr/textColorSecondary" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===== 双卡与边距 ===== -->
        <LinearLayout style="@style/ShellGroupHead">
            <TextView style="@style/ShellGroupTitle" android:text="@string/sb_group_dual" />
            <TextView android:id="@+id/infoSbDual" style="@style/ShellGroupInfo" />
            <View style="@style/ShellGroupRule" />
        </LinearLayout>
        <com.google.android.material.card.MaterialCardView style="@style/ShellPlate" android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="14dp">
            <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:divider="@drawable/bg_seam_line_inset" android:dividerHeight="1dp" android:showDividers="middle">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="15dp" android:paddingVertical="11dp">
                    <com.coloros16.liquidglass.ui.LgSwitch android:id="@+id/switchSbDualMerge" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/sb_dual_merge" android:thumb="@drawable/lg_sw_thumb" android:track="@drawable/lg_sw_track" android:textSize="15sp" android:textColor="@color/lg_ink_100" android:minHeight="0dp" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="15dp" android:paddingVertical="13dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:fontFamily="sans-serif-medium" android:text="@string/sb_dual_gap" android:textColor="@color/lg_ink_100" android:textSize="14sp" />
                        <TextView android:id="@+id/valSbDualGap" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="monospace" android:letterSpacing="0.04" android:textColor="@color/lg_blued_ink" android:textSize="13sp" />
                    </LinearLayout>
                    <SeekBar android:id="@+id/seekSbDualGap" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:progressDrawable="@drawable/lg_seek_track" android:splitTrack="false" android:thumb="@drawable/lg_seek_thumb" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="15dp" android:paddingVertical="13dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:fontFamily="sans-serif-medium" android:text="@string/sb_secondary_scale" android:textColor="@color/lg_ink_100" android:textSize="14sp" />
                        <TextView android:id="@+id/valSbSecondaryScale" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="monospace" android:letterSpacing="0.04" android:textColor="@color/lg_blued_ink" android:textSize="13sp" />
                    </LinearLayout>
                    <SeekBar android:id="@+id/seekSbSecondaryScale" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:progressDrawable="@drawable/lg_seek_track" android:splitTrack="false" android:thumb="@drawable/lg_seek_thumb" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="15dp" android:paddingVertical="13dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:fontFamily="sans-serif-medium" android:text="@string/sb_margin_left" android:textColor="@color/lg_ink_100" android:textSize="14sp" />
                        <TextView android:id="@+id/valSbMarginLeft" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="monospace" android:letterSpacing="0.04" android:textColor="@color/lg_blued_ink" android:textSize="13sp" />
                    </LinearLayout>
                    <SeekBar android:id="@+id/seekSbMarginLeft" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:progressDrawable="@drawable/lg_seek_track" android:splitTrack="false" android:thumb="@drawable/lg_seek_thumb" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="15dp" android:paddingVertical="13dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:fontFamily="sans-serif-medium" android:text="@string/sb_margin_right" android:textColor="@color/lg_ink_100" android:textSize="14sp" />
                        <TextView android:id="@+id/valSbMarginRight" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="monospace" android:letterSpacing="0.04" android:textColor="@color/lg_blued_ink" android:textSize="13sp" />
                    </LinearLayout>
                    <SeekBar android:id="@+id/seekSbMarginRight" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:progressDrawable="@drawable/lg_seek_track" android:splitTrack="false" android:thumb="@drawable/lg_seek_thumb" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===== 运营商文字 ===== -->
        <LinearLayout style="@style/ShellGroupHead">
            <TextView style="@style/ShellGroupTitle" android:text="@string/sb_group_carrier" />
            <View style="@style/ShellGroupRule" />
        </LinearLayout>
        <com.google.android.material.card.MaterialCardView style="@style/ShellPlate" android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="14dp">
            <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:divider="@drawable/bg_seam_line_inset" android:dividerHeight="1dp" android:showDividers="middle">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="15dp" android:paddingVertical="13dp">
                    <com.coloros16.liquidglass.ui.LgSwitch android:id="@+id/switchSbCarrierText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/sb_carrier_enable" android:thumb="@drawable/lg_sw_thumb" android:track="@drawable/lg_sw_track" android:textSize="15sp" android:textColor="@color/lg_ink_100" android:minHeight="0dp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/sb_carrier_enable_desc" android:textAppearance="?attr/textAppearanceBodySmall" android:textColor="?android:attr/textColorSecondary" />
                    <EditText android:id="@+id/editSbCarrierText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/bg_search" android:hint="@string/sb_carrier_hint" android:imeOptions="actionDone" android:inputType="text" android:maxLines="1" android:paddingHorizontal="14dp" android:paddingVertical="10dp" android:textColor="@color/lg_ink_100" android:textColorHint="@color/lg_ink_400" android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===== 通知中心时钟 ===== -->
        <LinearLayout style="@style/ShellGroupHead">
            <TextView style="@style/ShellGroupTitle" android:text="@string/sb_group_notif_clock" />
            <View style="@style/ShellGroupRule" />
        </LinearLayout>
        <com.google.android.material.card.MaterialCardView style="@style/ShellPlate" android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="14dp">
            <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:divider="@drawable/bg_seam_line_inset" android:dividerHeight="1dp" android:showDividers="middle">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="15dp" android:paddingVertical="13dp">
                    <com.coloros16.liquidglass.ui.LgSwitch android:id="@+id/switchSbNotifClock" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/sb_notif_clock_enable" android:thumb="@drawable/lg_sw_thumb" android:track="@drawable/lg_sw_track" android:textSize="15sp" android:textColor="@color/lg_ink_100" android:minHeight="0dp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/sb_notif_clock_enable_desc" android:textAppearance="?attr/textAppearanceBodySmall" android:textColor="?android:attr/textColorSecondary" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="15dp" android:paddingVertical="13dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="sans-serif-medium" android:text="@string/sb_notif_clock_gravity" android:textColor="@color/lg_ink_100" android:textSize="14sp" />
                    <Spinner android:id="@+id/spSbNotifClockGravity" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="15dp" android:paddingVertical="13dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="sans-serif-medium" android:text="@string/sb_notif_date_position" android:textColor="@color/lg_ink_100" android:textSize="14sp" />
                    <Spinner android:id="@+id/spSbNotifDatePosition" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="15dp" android:paddingVertical="13dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:fontFamily="sans-serif-medium" android:text="@string/sb_notif_clock_gap" android:textColor="@color/lg_ink_100" android:textSize="14sp" />
                        <TextView android:id="@+id/valSbNotifClockGap" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="monospace" android:letterSpacing="0.04" android:textColor="@color/lg_blued_ink" android:textSize="13sp" />
                    </LinearLayout>
                    <SeekBar android:id="@+id/seekSbNotifClockGap" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:progressDrawable="@drawable/lg_seek_track" android:splitTrack="false" android:thumb="@drawable/lg_seek_thumb" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="15dp" android:paddingVertical="13dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:fontFamily="sans-serif-medium" android:text="@string/sb_notif_clock_scale" android:textColor="@color/lg_ink_100" android:textSize="14sp" />
                        <TextView android:id="@+id/valSbNotifClockScale" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="monospace" android:letterSpacing="0.04" android:textColor="@color/lg_blued_ink" android:textSize="13sp" />
                    </LinearLayout>
                    <SeekBar android:id="@+id/seekSbNotifClockScale" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:progressDrawable="@drawable/lg_seek_track" android:splitTrack="false" android:thumb="@drawable/lg_seek_thumb" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="15dp" android:paddingVertical="13dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:fontFamily="sans-serif-medium" android:text="@string/sb_notif_date_size" android:textColor="@color/lg_ink_100" android:textSize="14sp" />
                        <TextView android:id="@+id/valSbNotifDateSize" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="monospace" android:letterSpacing="0.04" android:textColor="@color/lg_blued_ink" android:textSize="13sp" />
                    </LinearLayout>
                    <SeekBar android:id="@+id/seekSbNotifDateSize" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:progressDrawable="@drawable/lg_seek_track" android:splitTrack="false" android:thumb="@drawable/lg_seek_thumb" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="15dp" android:paddingVertical="11dp">
                    <com.coloros16.liquidglass.ui.LgSwitch android:id="@+id/switchSbNotifHideSettings" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/sb_notif_hide_settings" android:thumb="@drawable/lg_sw_thumb" android:track="@drawable/lg_sw_track" android:textSize="15sp" android:textColor="@color/lg_ink_100" android:minHeight="0dp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===== 时钟与排序 ===== -->
