                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="15dp" android:paddingVertical="11dp">
                    <com.coloros16.liquidglass.ui.LgSwitch android:id="@+id/switchSbNotifRight" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/sb_notif_right" android:thumb="@drawable/lg_sw_thumb" android:track="@drawable/lg_sw_track" android:textSize="15sp" android:textColor="@color/lg_ink_100" android:minHeight="0dp" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="15dp" android:paddingVertical="13dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:fontFamily="sans-serif-medium" android:text="@string/sb_order" android:textColor="@color/lg_ink_100" android:textSize="14sp" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/sbOrderReset" style="@style/ShellBtnText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="0dp" android:text="@string/sb_order_reset" android:textSize="12sp" />
                    </LinearLayout>
                    <FrameLayout android:id="@+id/sbOrderStrip" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/bg_sb_strip" android:padding="6dp">
                        <HorizontalScrollView android:id="@+id/sbOrderScroll" android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none" android:overScrollMode="never">
                            <LinearLayout android:id="@+id/sbOrderRow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" />
                        </HorizontalScrollView>
                    </FrameLayout>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/sb_order_hint" android:textAppearance="?attr/textAppearanceBodySmall" android:textColor="?android:attr/textColorSecondary" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
