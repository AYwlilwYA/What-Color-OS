<?xml version="1.0" encoding="utf-8"?>
<!-- [doc/spec/65] iOS 动态倾斜/透视二级页（实验性，默认关） -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <Switch android:id="@+id/switchNotificationDissolve" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/settings_notification_dissolve"
                    android:thumb="@drawable/lg_sw_thumb"
                    android:track="@drawable/lg_sw_track"
                        android:textSize="15sp"
                        android:textColor="@color/lg_ink_100"
                        android:minHeight="0dp"
                    />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/settings_notification_dissolve_desc"
            android:textAppearance="?attr/textAppearanceBodySmall" android:textColor="?android:attr/textColorSecondary" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:layout_marginTop="12dp">
    <TextView android:fontFamily="sans-serif-medium" android:textColor="@color/lg_ink_100" android:textSize="14sp" android:layout_width="0dp"
            android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/settings_notification_dissolve_speed" />
    <TextView android:id="@+id/notificationDissolveSpeedValue" android:fontFamily="monospace" android:letterSpacing="0.04" android:textColor="@color/lg_blued_ink" android:textSize="13sp" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginBottom="20dp" />
</LinearLayout>
        <SeekBar android:id="@+id/seekNotificationDissolveSpeed" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:max="265" android:progress="65"
                    android:progressDrawable="@drawable/lg_seek_track"
                    android:splitTrack="false"
                    android:thumb="@drawable/lg_seek_thumb"
                    />
        

        <Switch
            android:id="@+id/switchAnimTilt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_anim_tilt_enabled"
                    android:thumb="@drawable/lg_sw_thumb"
                    android:track="@drawable/lg_sw_track"
                        android:textSize="15sp"
                        android:textColor="@color/lg_ink_100"
                        android:minHeight="0dp"
                    />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/settings_anim_tilt_enabled_desc"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?android:attr/textColorSecondary" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:layout_marginTop="16dp">
    <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/settings_anim_tilt_strength"
            android:textAppearance="?attr/textAppearanceTitleSmall" />
    <TextView
            android:id="@+id/animTiltStrengthValue" android:fontFamily="monospace" android:letterSpacing="0.04" android:textColor="@color/lg_blued_ink" android:textSize="13sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
</LinearLayout>

        <SeekBar
            android:id="@+id/seekAnimTiltStrength"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:max="200"
            android:progress="100"
                    android:progressDrawable="@drawable/lg_seek_track"
                    android:splitTrack="false"
                    android:thumb="@drawable/lg_seek_thumb"
                    />

        

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/settings_anim_tilt_strength_desc"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?android:attr/textColorSecondary" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:layout_marginTop="16dp">
    <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/settings_anim_tilt_perspective"
            android:textAppearance="?attr/textAppearanceTitleSmall" />
    <TextView
            android:id="@+id/animTiltPerspectiveValue" android:fontFamily="monospace" android:letterSpacing="0.04" android:textColor="@color/lg_blued_ink" android:textSize="13sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
</LinearLayout>

        <SeekBar
            android:id="@+id/seekAnimTiltPerspective"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:max="150"
            android:progress="100"
                    android:progressDrawable="@drawable/lg_seek_track"
                    android:splitTrack="false"
                    android:thumb="@drawable/lg_seek_thumb"
                    />

        

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/settings_anim_tilt_perspective_desc"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?android:attr/textColorSecondary" />

        <!-- [doc/spec/65] 动态倾斜（桌面）：重启提示——必须在通知卡倾斜节【之前】，
             否则文案会盖到「立即生效」的通知卡节（审查 V-112 m-2 修复） -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/settings_anim_tilt_restart_note"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?android:attr/textColorSecondary" />

        <!-- [doc/spec/112] 通知卡倾斜：弹出/收回动画驱动（与上面 spec/65 桌面动态倾斜互不影响）。
             [审查 V-112 m-3 修复] 删全仓库唯一的 listDivider 分隔线——其余二级页一律标题+间距分节 -->
        <Switch
            android:id="@+id/switchNotifTilt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/settings_notif_tilt_enabled"
                    android:thumb="@drawable/lg_sw_thumb"
                    android:track="@drawable/lg_sw_track"
                        android:textSize="15sp"
                        android:textColor="@color/lg_ink_100"
                        android:minHeight="0dp"
                    />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/settings_notif_tilt_enabled_desc"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?android:attr/textColorSecondary" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:layout_marginTop="16dp">
    <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/settings_notif_tilt_strength"
            android:textAppearance="?attr/textAppearanceTitleSmall" />
    <TextView
            android:id="@+id/notifTiltStrengthValue" android:fontFamily="monospace" android:letterSpacing="0.04" android:textColor="@color/lg_blued_ink" android:textSize="13sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
</LinearLayout>

        <SeekBar
            android:id="@+id/seekNotifTiltStrength"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:max="45"
            android:progress="3"
                    android:progressDrawable="@drawable/lg_seek_track"
                    android:splitTrack="false"
                    android:thumb="@drawable/lg_seek_thumb"
                    />

        

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:layout_marginTop="16dp">
    <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/settings_notif_fly_scale"
            android:textAppearance="?attr/textAppearanceTitleSmall" />
    <TextView
            android:id="@+id/notifFlyScaleValue" android:fontFamily="monospace" android:letterSpacing="0.04" android:textColor="@color/lg_blued_ink" android:textSize="13sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
</LinearLayout>

        <SeekBar
            android:id="@+id/seekNotifFlyScale"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:max="80"
            android:progress="75"
                    android:progressDrawable="@drawable/lg_seek_track"
                    android:splitTrack="false"
                    android:thumb="@drawable/lg_seek_thumb"
                    />

        

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/settings_notif_tilt_strength_desc"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?android:attr/textColorSecondary" />

    </LinearLayout>
</ScrollView>
