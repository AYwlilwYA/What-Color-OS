<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <com.google.android.material.card.MaterialCardView style="@style/ShellPlate" android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="14dp">
            <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:divider="@drawable/bg_seam_line_inset" android:dividerHeight="1dp" android:showDividers="middle">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="15dp" android:paddingVertical="13dp">
                    <com.coloros16.liquidglass.ui.LgSwitch android:id="@+id/switchDockGlass" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/settings_dock_glass" android:thumb="@drawable/lg_sw_thumb" android:track="@drawable/lg_sw_track" android:textSize="15sp" android:textColor="@color/lg_ink_100"     android:minHeight="0dp"
                    />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="15dp" android:paddingVertical="13dp">
                    <com.coloros16.liquidglass.ui.LgSwitch android:id="@+id/switchCardGlass" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/settings_card_glass" android:thumb="@drawable/lg_sw_thumb" android:track="@drawable/lg_sw_track" android:textSize="15sp" android:textColor="@color/lg_ink_100"     android:minHeight="0dp"
                    />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="15dp" android:paddingVertical="13dp">
                    <com.coloros16.liquidglass.ui.LgSwitch android:id="@+id/switchPageIndicatorGlass" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/settings_page_indicator_glass" android:thumb="@drawable/lg_sw_thumb" android:track="@drawable/lg_sw_track" android:textSize="15sp" android:textColor="@color/lg_ink_100"     android:minHeight="0dp"
                    />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="15dp" android:paddingVertical="13dp">
                    <com.coloros16.liquidglass.ui.LgSwitch android:id="@+id/switchPopupMenuGlass" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/settings_popup_menu_glass" android:thumb="@drawable/lg_sw_thumb" android:track="@drawable/lg_sw_track" android:textSize="15sp" android:textColor="@color/lg_ink_100"     android:minHeight="0dp"
                    />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="15dp" android:paddingVertical="13dp">
                    <com.coloros16.liquidglass.ui.LgSwitch android:id="@+id/switchClearAllBtnGlass" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/settings_clear_all_btn_glass" android:thumb="@drawable/lg_sw_thumb" android:track="@drawable/lg_sw_track" android:textSize="15sp" android:textColor="@color/lg_ink_100"     android:minHeight="0dp"
                    />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_plate" android:divider="@drawable/bg_seam_line_inset" android:dividerHeight="1dp" android:orientation="vertical" android:showDividers="middle">
            <include android:id="@+id/deskEditRow" layout="@layout/item_row" android:layout_width="match_parent" android:layout_height="wrap_content" />
        </LinearLayout>
        <TextView style="@style/ShellHint" android:text="@string/settings_obj_desktop_hint" />
    </LinearLayout>
</ScrollView>
