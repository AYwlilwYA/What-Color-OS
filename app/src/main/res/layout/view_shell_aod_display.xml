<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <com.coloros16.liquidglass.ui.aod.AodPreviewView
        android:id="@+id/aodPreview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <View
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:background="@drawable/bg_aod_scrim_top" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp">

        <TextView
            android:id="@+id/aodCancel"
            android:layout_width="64dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_aod_float"
            android:gravity="center"
            android:text="@string/settings_aod_cancel"
            android:textColor="#F2FFFFFF"
            android:textSize="14sp"
            android:textStyle="normal"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/aodHeaderLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center"
            android:singleLine="true"
            android:text="@string/settings_aod_display_title"
            android:textColor="#D9FFFFFF"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/aodApply"
            android:layout_width="64dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_aod_apply"
            android:gravity="center"
            android:text="@string/settings_aod_apply"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:textStyle="normal"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <TextView
        android:id="@+id/aodScrubBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="54dp"
        android:background="@drawable/bg_aod_badge"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.04"
        android:paddingStart="12dp"
        android:paddingTop="5dp"
        android:paddingEnd="12dp"
        android:paddingBottom="5dp"
        android:singleLine="true"
        android:textColor="#E6FFFFFF"
        android:textSize="11sp"
        android:visibility="gone" />

    <View
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_aod_scrim_bottom" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="16dp">

        <com.coloros16.liquidglass.ui.aod.AodStateBar
            android:id="@+id/aodStateBar"
            android:layout_width="232dp"
            android:layout_height="48dp" />

        <TextView
            android:id="@+id/aodHint"
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:letterSpacing="0.02"
            android:singleLine="true"
            android:text="@string/settings_aod_page_hint"
            android:textColor="#61FFFFFF"
            android:textSize="11sp" />

        <LinearLayout
            android:id="@+id/aodDockBar"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_aod_dock_bar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp" />
    </LinearLayout>
</FrameLayout>
