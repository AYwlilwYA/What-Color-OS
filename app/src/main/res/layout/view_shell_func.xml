<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <EditText
        android:id="@+id/funcSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_search"
        android:drawableStart="@drawable/ic_search"
        android:drawablePadding="10dp"
        android:hint="@string/settings_func_search_hint"
        android:imeOptions="actionSearch"
        android:inputType="text"
        android:maxLines="1"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="@color/lg_ink_100"
        android:textColorHint="@color/lg_ink_400"
        android:textSize="14sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout style="@style/ShellGroupHead">
                <TextView
                    style="@style/ShellGroupTitle"
                    android:text="@string/settings_func_group" />
                <View style="@style/ShellGroupRule" />
            </LinearLayout>

<LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_plate"
            android:divider="@drawable/bg_seam_line_inset"
            android:dividerHeight="1dp"
            android:orientation="vertical"
            android:showDividers="middle">

            <include
                    android:id="@+id/funcRowGlass"
                    layout="@layout/item_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <include
                    android:id="@+id/funcRowCorner"
                    layout="@layout/item_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <include
                    android:id="@+id/funcRowPanel"
                    layout="@layout/item_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <include
                    android:id="@+id/funcRowLauncher"
                    layout="@layout/item_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <include
                    android:id="@+id/funcRowSeedling"
                    layout="@layout/item_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <include
                    android:id="@+id/funcRowAod"
                    layout="@layout/item_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <include
                    android:id="@+id/funcRowStatusbar"
                    layout="@layout/item_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

        </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="@string/settings_func_hint"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?android:attr/textColorSecondary" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
