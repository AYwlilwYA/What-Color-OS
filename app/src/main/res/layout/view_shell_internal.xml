<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="16dp" android:paddingBottom="24dp">
        <LinearLayout style="@style/ShellGroupHead">
            <TextView style="@style/ShellGroupTitle" android:text="@string/settings_internal_group_logs" />
            <View style="@style/ShellGroupRule" />
        </LinearLayout>
        <com.google.android.material.card.MaterialCardView style="@style/ShellPlate" android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="14dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                <com.coloros16.liquidglass.ui.LgSwitch android:id="@+id/switchEnableLogs" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="0dp" android:text="@string/settings_enable_logs" android:textColor="@color/lg_ink_100" android:textSize="15sp" android:thumb="@drawable/lg_sw_thumb" android:track="@drawable/lg_sw_track" />
                <TextView android:id="@+id/enableLogsDesc" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/settings_enable_logs_desc" android:textAppearance="?attr/textAppearanceBodySmall" android:textColor="?android:attr/textColorSecondary" />
                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="16dp" android:layout_marginBottom="12dp" android:background="?attr/colorOutlineVariant" />
                <com.coloros16.liquidglass.ui.LgSwitch android:id="@+id/switchEngineFullLog" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="0dp" android:text="@string/settings_engine_full_log" android:textColor="@color/lg_ink_100" android:textSize="15sp" android:thumb="@drawable/lg_sw_thumb" android:track="@drawable/lg_sw_track" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/settings_engine_full_log_desc" android:textAppearance="?attr/textAppearanceBodySmall" android:textColor="?android:attr/textColorSecondary" />
                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="16dp" android:layout_marginBottom="12dp" android:background="?attr/colorOutlineVariant" />
                <com.coloros16.liquidglass.ui.LgSwitch android:id="@+id/switchCaptureAll" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="0dp" android:text="@string/settings_capture_include_all" android:textColor="@color/lg_ink_100" android:textSize="15sp" android:thumb="@drawable/lg_sw_thumb" android:track="@drawable/lg_sw_track" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/settings_internal_capture_all_desc" android:textAppearance="?attr/textAppearanceBodySmall" android:textColor="?android:attr/textColorSecondary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <TextView style="@style/ShellHint" android:text="@string/settings_internal_log_hint" />
    </LinearLayout>
</ScrollView>
