<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="16dp" android:paddingBottom="24dp">
        <LinearLayout style="@style/ShellGroupHead">
            <TextView style="@style/ShellGroupTitle" android:text="@string/settings_launcher_group_anim" />
            <View style="@style/ShellGroupRule" />
        </LinearLayout>
        <com.google.android.material.card.MaterialCardView style="@style/ShellPlate" android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="14dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                <com.coloros16.liquidglass.ui.LgSwitch android:id="@+id/switchAnimOpen" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/settings_anim_open_enabled" android:thumb="@drawable/lg_sw_thumb" android:track="@drawable/lg_sw_track" android:textSize="15sp" android:textColor="@color/lg_ink_100"     android:minHeight="0dp"
                    />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/settings_anim_open_enabled_desc" android:textAppearance="?attr/textAppearanceBodySmall" android:textColor="?android:attr/textColorSecondary" />
                <LinearLayout android:id="@+id/rowAnimOpen" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="?attr/selectableItemBackground" android:gravity="center_vertical" android:orientation="horizontal" android:paddingVertical="10dp">
                    <TextView android:fontFamily="sans-serif-medium" android:textColor="@color/lg_ink_100" android:textSize="15sp" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/settings_anim_open_params" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="@color/lg_ink_400" android:textSize="18sp" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="12dp" android:layout_marginBottom="12dp" android:background="?attr/colorOutlineVariant" />
                <com.coloros16.liquidglass.ui.LgSwitch android:id="@+id/switchAnimClose" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/settings_anim_close_enabled" android:thumb="@drawable/lg_sw_thumb" android:track="@drawable/lg_sw_track" android:textSize="15sp" android:textColor="@color/lg_ink_100"     android:minHeight="0dp"
                    />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/settings_anim_close_enabled_desc" android:textAppearance="?attr/textAppearanceBodySmall" android:textColor="?android:attr/textColorSecondary" />
                <LinearLayout android:id="@+id/rowAnimClose" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="?attr/selectableItemBackground" android:gravity="center_vertical" android:orientation="horizontal" android:paddingVertical="10dp">
                    <TextView android:fontFamily="sans-serif-medium" android:textColor="@color/lg_ink_100" android:textSize="15sp" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/settings_anim_close_params" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="@color/lg_ink_400" android:textSize="18sp" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="12dp" android:layout_marginBottom="12dp" android:background="?attr/colorOutlineVariant" />
                <com.coloros16.liquidglass.ui.LgSwitch android:id="@+id/switchAnimBreak" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/settings_anim_break_enabled" android:thumb="@drawable/lg_sw_thumb" android:track="@drawable/lg_sw_track" android:textSize="15sp" android:textColor="@color/lg_ink_100"     android:minHeight="0dp"
                    />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/settings_anim_break_enabled_desc" android:textAppearance="?attr/textAppearanceBodySmall" android:textColor="?android:attr/textColorSecondary" />
                <LinearLayout android:id="@+id/rowAnimBreak" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="?attr/selectableItemBackground" android:gravity="center_vertical" android:orientation="horizontal" android:paddingVertical="10dp">
                    <TextView android:fontFamily="sans-serif-medium" android:textColor="@color/lg_ink_100" android:textSize="15sp" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/settings_anim_break_params" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="@color/lg_ink_400" android:textSize="18sp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <TextView style="@style/ShellHint" android:text="@string/settings_anim_restart_note" />
        <LinearLayout style="@style/ShellGroupHead">
            <TextView style="@style/ShellGroupTitle" android:text="@string/settings_launcher_group_tilt" />
            <View style="@style/ShellGroupRule" />
        </LinearLayout>
        <com.google.android.material.card.MaterialCardView style="@style/ShellPlate" android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="14dp">
            <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:divider="@drawable/bg_seam_line_inset" android:dividerHeight="1dp" android:showDividers="middle">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="15dp" android:paddingVertical="13dp">
                    <com.coloros16.liquidglass.ui.LgSwitch android:id="@+id/switchAnimTilt" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/settings_anim_tilt_enabled" android:thumb="@drawable/lg_sw_thumb" android:track="@drawable/lg_sw_track" android:textSize="15sp" android:textColor="@color/lg_ink_100"     android:minHeight="0dp"
                    />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/settings_anim_tilt_enabled_desc" android:textAppearance="?attr/textAppearanceBodySmall" android:textColor="?android:attr/textColorSecondary" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="15dp" android:paddingVertical="13dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
    <TextView android:layout_width="0dp"
            android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/settings_anim_tilt_strength" android:textAppearance="?attr/textAppearanceTitleSmall" />
    <TextView android:id="@+id/animTiltStrengthValue" android:fontFamily="monospace" android:letterSpacing="0.04" android:textColor="@color/lg_blued_ink" android:textSize="13sp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
</LinearLayout>
                    <SeekBar android:id="@+id/seekAnimTiltStrength" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:max="200" android:progress="100" android:progressDrawable="@drawable/lg_seek_track" android:splitTrack="false" android:thumb="@drawable/lg_seek_thumb" />
                    
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/settings_anim_tilt_strength_desc" android:textAppearance="?attr/textAppearanceBodySmall" android:textColor="?android:attr/textColorSecondary" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="15dp" android:paddingVertical="13dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
    <TextView android:layout_width="0dp"
            android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/settings_anim_tilt_perspective" android:textAppearance="?attr/textAppearanceTitleSmall" />
    <TextView android:id="@+id/animTiltPerspectiveValue" android:fontFamily="monospace" android:letterSpacing="0.04" android:textColor="@color/lg_blued_ink" android:textSize="13sp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
</LinearLayout>
                    <SeekBar android:id="@+id/seekAnimTiltPerspective" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:max="150" android:progress="100" android:progressDrawable="@drawable/lg_seek_track" android:splitTrack="false" android:thumb="@drawable/lg_seek_thumb" />
                    
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/settings_anim_tilt_perspective_desc" android:textAppearance="?attr/textAppearanceBodySmall" android:textColor="?android:attr/textColorSecondary" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <TextView style="@style/ShellHint" android:text="@string/settings_anim_tilt_restart_note" />
    </LinearLayout>
</ScrollView>
