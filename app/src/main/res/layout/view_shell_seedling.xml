<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingBottom="24dp">

        <LinearLayout style="@style/ShellGroupHead">
            <TextView
                style="@style/ShellGroupTitle"
                android:text="@string/settings_seedling_group" />
            <View style="@style/ShellGroupRule" />
        </LinearLayout>

<LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_plate"
            android:divider="@drawable/bg_seam_line_inset"
            android:dividerHeight="1dp"
            android:orientation="vertical"
            android:showDividers="middle">

        <include
                android:id="@+id/seedlingGlassRow"
                layout="@layout/item_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

        </LinearLayout>

        <TextView
            style="@style/ShellHint"
            android:text="@string/settings_seedling_page_hint" />
    </LinearLayout>
</ScrollView>
